{
  "name": "BD2 Command Center",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.wordWrap": "on",
        "editor.formatOnSave": false,
        "files.defaultLanguage": "html"
      },
      "extensions": [
        "ritwickdey.LiveServer",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [5500],
  "postCreateCommand": "echo '⚡ BD2 Command Center ready. Open index.html and use Live Server to preview, or run: python3 deploy.py'"
}
